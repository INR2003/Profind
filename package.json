    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.38.0",
    "oxlint": "^1.79.0",
    "tailwind-merge": "^3.6.0",
